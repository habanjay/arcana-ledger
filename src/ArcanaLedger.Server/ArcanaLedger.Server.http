@Server_HostAddress = http://localhost:5347
@Api = {{Server_HostAddress}}/api/v1

GET {{Server_HostAddress}}/api/weatherforecast/
Accept: application/json

###

# Register before login. Instrument requests require instruments imported into PostgreSQL.

# @name register
POST {{Api}}/auth/register
Content-Type: application/json

{
  "email": "new-trader@example.com",
  "displayName": "New Trader",
  "password": "AnotherStr0ngPassword!"
}

###

# @name login
POST {{Api}}/auth/login
Content-Type: application/json

{
  "email": "new-trader@example.com",
  "password": "AnotherStr0ngPassword!"
}

###

@authToken = {{login.response.body.$.accessToken}}

GET {{Api}}/auth/me
Authorization: Bearer {{authToken}}

###

POST {{Api}}/auth/logout
Authorization: Bearer {{authToken}}

###

GET {{Api}}/portfolios
Authorization: Bearer {{authToken}}

###

@portfolioId = {{createPortfolio.response.body.$.id}}

GET {{Api}}/portfolios/{{portfolioId}}
Authorization: Bearer {{authToken}}

###

# @name createPortfolio
POST {{Api}}/portfolios
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "name": "Growth",
  "baseCurrency": "CAD",
  "isDefault": true
}

###

PATCH {{Api}}/portfolios/{{portfolioId}}
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "name": "Growth (Aggressive)"
}

###

GET {{Api}}/portfolios/{{portfolioId}}/accounts
Authorization: Bearer {{authToken}}

###

# @name createAccount
POST {{Api}}/portfolios/{{portfolioId}}/accounts
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "name": "Questrade Margin",
  "brokerName": "Questrade",
  "currency": "CAD"
}

###

# @name searchInstrument
GET {{Api}}/instruments?search=AAPL
Authorization: Bearer {{authToken}}

###

@instrumentId = {{searchInstrument.response.body.$[0].id}}

GET {{Api}}/instruments/{{instrumentId}}
Authorization: Bearer {{authToken}}

###

GET {{Api}}/portfolios/{{portfolioId}}/watchlist
Authorization: Bearer {{authToken}}

###

POST {{Api}}/portfolios/{{portfolioId}}/watchlist
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "instrumentId": "{{instrumentId}}",
  "displayOrder": 0
}

###

GET {{Api}}/trade-setups
Authorization: Bearer {{authToken}}

###

POST {{Api}}/trade-setups
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "code": "BOOMER",
  "name": "Boomer",
  "family": "position",
  "entryRule": "Breakout above 20-day high with volume confirmation.",
  "exitRule": "Close below 10-day EMA.",
  "trend": "up",
  "usesTranches": true,
  "trancheCount": 3,
  "varMultiplier": 1.5,
  "usageNotes": "Use for high-conviction, longer-duration positions."
}

###

@accountId = {{createAccount.response.body.$.id}}

GET {{Api}}/trades?portfolioId={{portfolioId}}
Authorization: Bearer {{authToken}}

###

# @name createTrade
POST {{Api}}/trades
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "accountId": "{{accountId}}",
  "instrumentId": "{{instrumentId}}",
  "orderType": "long",
  "openedOn": "2026-09-29",
  "entryTarget": "180.00000000",
  "cutLoss": "172.00000000",
  "targetPrice": "205.00000000",
  "notes": "Breakout setup off the August base."
}

###

@tradeId = {{createTrade.response.body.$.id}}

GET {{Api}}/trades/{{tradeId}}
Authorization: Bearer {{authToken}}

###

POST {{Api}}/trades/{{tradeId}}/executions
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "side": "buy",
  "quantity": "50.00000000",
  "price": "181.20000000",
  "commission": "1.99000000",
  "executedAt": "2026-09-29T14:31:00Z"
}

###

GET {{Api}}/portfolios/{{portfolioId}}/transactions
Authorization: Bearer {{authToken}}

###

POST {{Api}}/portfolios/{{portfolioId}}/transactions
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "accountId": "{{accountId}}",
  "transactionType": "deposit",
  "cashAmount": "5000.00000000",
  "currency": "CAD",
  "occurredAt": "2026-09-29T14:00:00Z",
  "memo": "Initial funding"
}

###

GET {{Api}}/portfolios/{{portfolioId}}/snapshots
Authorization: Bearer {{authToken}}

###

GET {{Api}}/portfolios/{{portfolioId}}/activity?limit=10
Authorization: Bearer {{authToken}}

###

GET {{Api}}/portfolios/{{portfolioId}}/dashboard
Authorization: Bearer {{authToken}}

###

GET {{Api}}/valuations
Authorization: Bearer {{authToken}}

###

# @name createValuation
POST {{Api}}/valuations
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "portfolioId": "{{portfolioId}}",
  "instrumentId": "{{instrumentId}}",
  "name": "AAPL base case",
  "estimatedRevenue": "400000000000.00000000",
  "estimatedNetIncome": "100000000000.00000000",
  "actualPriorYearRevenue": "383000000000.00000000",
  "actualPriorYearNetIncome": "97000000000.00000000",
  "sharesOutstanding": "15200000000.00000000",
  "revenueGrowthRate": 0.08,
  "terminalMargin": 0.25,
  "peMultiple": 28,
  "currentPrice": "182.50000000",
  "discountRate": 0.08,
  "forecastYears": 5
}

###

@valuationId = {{createValuation.response.body.$.id}}

GET {{Api}}/valuations/{{valuationId}}
Authorization: Bearer {{authToken}}

###

GET {{Api}}/valuations/{{valuationId}}/forecasts
Authorization: Bearer {{authToken}}

###

GET {{Api}}/portfolios/{{portfolioId}}/settings
Authorization: Bearer {{authToken}}

###

PUT {{Api}}/portfolios/{{portfolioId}}/settings
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "capital": "100000.00000000",
  "varRate": 0.02,
  "cashValue": "15000.00000000",
  "reserveValue": "10000.00000000",
  "positionEntryPrice": "180.00000000",
  "positionExitPrice": "172.00000000",
  "positionShares": "50.00000000",
  "positionCashValue": "9000.00000000",
  "trancheEntryPrice": "180.00000000",
  "trancheExitPrice": "172.00000000",
  "trancheShares": "17.00000000",
  "trancheCashValue": "3060.00000000",
  "swingEntryPrice": "180.00000000",
  "swingExitPrice": "172.00000000",
  "swingShares": "25.00000000",
  "swingCashValue": "4500.00000000",
  "breakoutPrice": "185.00000000",
  "patternLowPrice": "170.00000000",
  "swingTargetPrice": "205.00000000",
  "momentumRate": 0.015
}

###